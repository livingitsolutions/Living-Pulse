{
  "name": "living-pulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:public",
    "build:public": "tsc -b && vite build --config vite.public.config.ts",
    "build:growth": "tsc -b && vite build --config vite.growth.config.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "node scripts/verify-public-site.mjs && vitest run",
    "sync:public-site": "node scripts/verify-public-site.mjs --write",
    "prospects:import": "vite-node scripts/import-prospects.ts"
  },
  "dependencies": {
    "@netlify/database": "latest",
    "@netlify/functions": "latest",
    "drizzle-orm": "beta",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "beta",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
